# Copy to .env and fill in.   cp .env.example .env
#
# ============================================================================
# THE SHORT VERSION -- you need exactly three things to get green:
#
#   1. one working LLM key      (see LLM section; embeddings are already local)
#   2. SLACK_BOT_TOKEN          (xoxb-, from your Slack app)
#   3. SLACK_TEST_CHANNEL       (a channel ID the bot has been invited to)
#
# Everything else in this file already has a working default.
# ============================================================================


# ============================================================================
# 1. LLM  -- required
# ============================================================================
# cognee reads LLM_API_KEY (not OPENAI_API_KEY -- _guard.py maps that across
# for you if it is exported globally).
#
# cognee's KNOWN_LLM_PROVIDERS:
#   openai · anthropic · gemini · mistral · azure · bedrock
#   ollama · llama_cpp · custom · mcp-sampling
#
# Anything litellm supports but cognee does not name goes through
# LLM_PROVIDER=custom with a litellm model prefix. Nebius is exactly that case.
#
# Pick ONE block and uncomment it.

# --- Gemini  (recommended: first-class in cognee, fast, cheap) --------------
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_API_KEY=AIza...

# --- Nebius  (litellm-native via the nebius/ prefix, routed as "custom") ----
# No LLM_ENDPOINT needed -- litellm knows the nebius/ prefix natively.
# Browse models at https://studio.nebius.com/
# LLM_PROVIDER=custom
# LLM_MODEL=nebius/Qwen/Qwen3-30B-A3B
# LLM_API_KEY=eyJ...
#
# other Nebius models worth trying:
#   nebius/meta-llama/Llama-3.3-70B-Instruct
#   nebius/deepseek-ai/DeepSeek-V3

# --- OpenAI ----------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-5-mini
# LLM_API_KEY=sk-...

# --- Anthropic -------------------------------------------------------------
# NOTE: Anthropic has NO embeddings API. Keep EMBEDDING_PROVIDER=fastembed.
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-sonnet-5
# LLM_API_KEY=sk-ant-...

# --- Any other OpenAI-compatible endpoint (Groq, OpenRouter, vLLM, ...) -----
# LLM_PROVIDER=custom
# LLM_MODEL=openai/llama-3.3-70b-versatile
# LLM_ENDPOINT=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# --- Ollama, fully local / offline -----------------------------------------
# Needs `ollama serve` running and the model pulled first.
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/qwen3:8b
# LLM_ENDPOINT=http://localhost:11434


# ============================================================================
# 2. Provider keys for `python t_llm_probe.py --all`
# ============================================================================
# The probe sweeps every provider you have a key for and reports which ones
# pass STRUCTURED OUTPUT (what cognee's extraction actually needs), not just
# chat. Deliberately no cross-provider fallback: an OpenAI key sent to Gemini
# returns "API key not valid", which reads like a bad key rather than a missing
# one. Fill in whichever you have; blanks are skipped honestly.
GEMINI_API_KEY=
NEBIUS_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Read from your global shell environment if set, and mapped to LLM_API_KEY by
# _guard.py when LLM_API_KEY is empty. Listed here so you know it is in play:
# if an OPENAI_API_KEY is exported in your shell, it becomes the default LLM
# key even though nothing in this file mentions it. (On this machine it is
# exported and has no credits, which is what the FAILs were.) Set LLM_API_KEY
# explicitly above to override it.
# OPENAI_API_KEY=sk-...


# ============================================================================
# 3. Embeddings -- configured SEPARATELY from the LLM
# ============================================================================
# The trap: LLM_PROVIDER does not imply the embedding provider. Point the LLM
# at Anthropic and change nothing else, and cognee still embeds through OpenAI
# -- so you hit the same dead key you were working around, in a step you were
# not watching.
#
# ############################################################################
# ALWAYS SET EMBEDDING_DIMENSIONS EXPLICITLY.
#
# cognee tries to look the number up from litellm/fastembed and, when it
# cannot, silently falls back to 3072 (_FALLBACK_DIMENSIONS). litellm does NOT
# know Voyage's vector sizes -- verified here: voyage-3-large resolves to None
# -> 3072, while the model actually returns 1024. cognee's own source calls
# this "the source of the silent Vector(3072) mismatch on every non-OpenAI
# embedder". You get a Qdrant collection sized 3072 fed by 1024-d vectors.
# Run `python t_embed_probe.py` to check config against reality.
# ############################################################################

# --- Voyage AI  (RECOMMENDED for quality) ----------------------------------
# Best-in-class retrieval quality. Cheap at hackathon volume: a few hundred
# Slack messages costs well under a cent.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage/voyage-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=pa-...
#
# voyage-context-3 is worth testing head to head for Slack specifically: it is
# a CONTEXTUALIZED model, embedding each chunk with awareness of surrounding
# context. Slack is the ideal case -- a reply of "agreed" is meaningless
# without its parent message. Same price as voyage-3-large.
# EMBEDDING_MODEL=voyage/voyage-context-3
#
# cheaper Voyage options (both 1024-d):
#   voyage/voyage-3.5        $0.06/Mtok   very strong
#   voyage/voyage-3.5-lite   $0.02/Mtok   fast, still decent

# --- fastembed, local  (offline fallback; keep this working) ---------------
# fastembed is Qdrant's own library, so this is the Qdrant-native local path.
# Free, CPU-only, no network after the first download. This is what makes the
# LLM-free t0b_qdrant_write.py test possible and is your insurance against bad
# conference wifi. Verified working here.
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS=384
#
# stronger local models, if you want local AND better quality:
#   BAAI/bge-large-en-v1.5              1024-d   1.20 GB
#   mixedbread-ai/mxbai-embed-large-v1  1024-d   0.64 GB   <- best size/quality
#   snowflake/snowflake-arctic-embed-l  1024-d   1.02 GB
#   jinaai/jina-embeddings-v3           1024-d   2.29 GB

# --- OpenAI ----------------------------------------------------------------
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072

# --- Gemini ----------------------------------------------------------------
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini/text-embedding-004
# EMBEDDING_DIMENSIONS=768

# Voyage key for t_embed_probe.py (kept separate so the probe can sweep
# providers without cross-contaminating keys, same as the LLM probe).
VOYAGE_API_KEY=

# Optional. Without `transformers` installed, cognee falls back to TikToken for
# token counting and warns that chunk sizing is approximate. Harmless for a
# demo. Set this to a tokenizer matching your embedding model to silence it.
# HUGGINGFACE_TOKENIZER=BAAI/bge-small-en-v1.5

# Optional. fastembed downloads from HuggingFace unauthenticated and warns
# about rate limits. A token makes the first download faster/more reliable.
# HF_TOKEN=hf_...


# ============================================================================
# 4. Vector store: Qdrant
# ============================================================================
# Start it with ./run_qdrant.sh (downloads the binary if missing).
# Note: VECTOR_DB_PROVIDER alone does NOT switch cognee to Qdrant -- the
# community adapter must also be registered, which _guard.py does on import.
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_KEY=

# REQUIRED, and documented nowhere. cognee's VectorConfig.fill_derived()
# auto-corrects this handler for pgvector and turso but has no branch for
# qdrant, because qdrant is a community adapter cognee core does not know
# about. Left alone it silently stays "lancedb" and the first write dies with:
#   "The selected vector dataset to database handler does not work with the
#    configured vector database provider ... Selected: qdrant / lancedb"
# That error names ENABLE_BACKEND_ACCESS_CONTROL, which sends you the wrong
# way -- turning access control off also clears it, but silently surrenders
# multi-user ACL. Set the handler instead.
VECTOR_DATASET_DATABASE_HANDLER=qdrant

# Graph store. Default is Ladybug/Kuzu, embedded, no server needed. Only set
# this if you want Neo4j for a nicer graph picture in the demo.
# GRAPH_DATABASE_PROVIDER=neo4j
# GRAPH_DATABASE_URL=bolt://localhost:7687
# GRAPH_DATABASE_USERNAME=neo4j
# GRAPH_DATABASE_PASSWORD=


# ============================================================================
# 5. Slack -- required for the T1/T2 tests
# ============================================================================
# Create the app from slack-app-manifest.yaml (one paste, all scopes set).
#
# Bot User OAuth Token. Scopes needed:
#   channels:history · groups:history · channels:read · users:read
#   reactions:read   · pins:read      · chat:write
# Adding a scope does NOT update a live token -- you must REINSTALL the app.
# t1_slack.py reads the granted scopes back from the auth.test response
# headers precisely to catch that.
# Format: xoxb-...   (left blank on purpose -- a placeholder value here would
# be treated as a real token and fail with invalid_auth instead of skipping)
SLACK_BOT_TOKEN=

# App-level token, needs connections:write. REQUIRED -- seed/listen_slack.py is
# the whole product and it cannot open Socket Mode without this. (It used to be
# optional, back when the read-only history tests were the point.)
# Per-reaction timestamps exist only in live events -- the Web API and exports
# carry none -- so reaction *timing* is impossible without this.
# Basic Information -> App-Level Tokens -> Generate -> scope connections:write
# Format: xapp-...
SLACK_APP_TOKEN=

# Channel the tests read from. ID form (C0123ABCD) is safest.
# Get it: right-click the channel -> View channel details -> bottom of the pane.
# Invite the bot first:  /invite @cognee-graph
SLACK_TEST_CHANNEL=

# App ID (A0123ABCD). Not used to authenticate anything -- it is how you tell
# two installs of the same app apart when you have one per workspace.
SLACK_APP_ID=


# ============================================================================
# 6. cognee behaviour
# ============================================================================
# Don't phone home (and don't try to, on conference wifi).
TELEMETRY_DISABLED=1

# cognee auto-throttles to 60 req/60s for 900s after ANY provider 429. On a
# shared organiser key that is 15 minutes of unexplained slowness with no
# visible cause. Off by default here.
AUTO_RATE_LIMIT=false
# LLM_RATE_LIMIT_REQUESTS=60
# LLM_RATE_LIMIT_INTERVAL=60

# cognee pings the LLM at startup and, on failure, reports "connection test
# timed out after 30s" -- hiding the real cause behind a 30s wait. With this
# set you get the provider's actual error ("You have no credits remaining",
# "invalid api key") immediately. Better for a test rig.
COGNEE_SKIP_CONNECTION_TEST=true

# Multi-user access control. On by default. Leave it alone unless you hit the
# handler error above -- and if you do, fix VECTOR_DATASET_DATABASE_HANDLER
# rather than switching this off.
# ENABLE_BACKEND_ACCESS_CONTROL=false

# Session memory / response caching, on by default.
# CACHING=false


# ============================================================================
# 7. LANGFUSE -- leave these UNSET unless you really want tracing
# ============================================================================
# Two separate traps, both live on this machine, both handled by _guard.py:
#
#   Only the public key set  -> `import cognee` fails outright with a pydantic
#                               ValidationError naming neither langfuse nor
#                               your code. 20 minutes of mystery if you meet it
#                               cold.
#   BOTH keys set            -> cognee exports every span through
#                               SimpleSpanProcessor: one blocking HTTPS POST
#                               per span, on the event loop. cognify looks like
#                               it hung. COGNEE_TRACING_ENABLED=false does NOT
#                               stop it -- a validator re-enables tracing
#                               whenever a key is present. Unsetting is the
#                               only real off switch.
#
# So: set BOTH or NEITHER. Never one.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# ============================================================================
# ElevenLabs (optional -- demo voice output)
# ============================================================================
# Only needed for voice.py. Get a key at
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Rachel: present on every plan including free, so the demo cannot die because
# a fancier voice turns out to be plan-gated.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# turbo = low latency. On stage, 400ms vs 2s of dead air is the whole impression.
ELEVENLABS_MODEL=eleven_turbo_v2_5
