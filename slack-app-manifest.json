{
  "display_information": {
    "name": "cognee-graph",
    "description": "Builds a knowledge graph from Slack conversations via cognee + Qdrant",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "cognee-graph",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "users:read",
        "reactions:read",
        "pins:read",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
